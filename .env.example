# scripts/dev.py backend-run reads .env. Docker Compose also reads this file.
SPRING_PROFILES_ACTIVE=live
DB_PORT=55432
DB_URL=jdbc:postgresql://127.0.0.1:55432/knowledge_base
DB_USER=knowledge
DB_PASSWORD=replace-with-a-strong-database-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
STORAGE_TYPE=local
STORAGE_PATH=./data/files
# Chat and embedding are independent services. Use the origin without /v1.
AI_BASE_URL=https://ai-api.m2time.com
AI_CHAT_MODEL=gpt-6.1-sol
# Fill this locally when ready, then restart the backend.
AI_API_KEY=
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=ollama
AI_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_SEND_DIMENSIONS=false
RETRIEVAL_MIN_SCORE=0.55
WEB_PORT=8088
COOKIE_SECURE=false
# Optional one-time import from a backed-up H2 demo database, without .mv.db suffix.
IMPORT_DEMO_PATH=
