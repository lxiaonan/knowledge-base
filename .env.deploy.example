# Separate from the development .env. The deployment script generates passwords.
DB_PASSWORD=replace-with-a-strong-database-password
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
WEB_BIND=127.0.0.1
WEB_PORT=8088
COOKIE_SECURE=false
AI_BASE_URL=https://ai-api.m2time.com
AI_CHAT_MODEL=gpt-6.1-sol
AI_API_KEY=
AI_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
RETRIEVAL_MIN_SCORE=0.55
# Optional: pin an Ollama image version or digest.
OLLAMA_IMAGE=ollama/ollama:latest
# Docker builds backend/ and frontend/ from the same checkout.
# No local Java, Node.js or Ollama needed.
